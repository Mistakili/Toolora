{
  "manifest_version": 3,
  "name": "Toolora — Free Online Tools",
  "version": "1.0.0",
  "description": "Quick access to all 20+ Toolora tools. Select text on any page to send it directly to a tool.",
  "permissions": ["contextMenus", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toolora Tools",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
